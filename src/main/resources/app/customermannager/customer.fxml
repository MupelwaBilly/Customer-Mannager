<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="16" styleClass="root-pane" xmlns:fx="http://javafx.com/fxml"
      fx:controller="app.customermannager.CustomerController">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Customer Manager" styleClass="title"/>

    <VBox spacing="8" styleClass="card">
        <Label text="Name"/>
        <TextField fx:id="nameField" promptText="Enter full name"/>

        <Label text="Province"/>
        <ComboBox fx:id="provinceBox" promptText="Select province" maxWidth="Infinity"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="6" right="0" bottom="0" left="0"/></padding>
            <Button text="Add" onAction="#onAdd" defaultButton="true"/>
            <Button text="Delete selected" onAction="#onDelete" styleClass="danger"/>
        </HBox>

        <Label fx:id="errorLabel" styleClass="error-label"/>
    </VBox>

    <VBox spacing="8" styleClass="card" VBox.vgrow="ALWAYS">
        <Label fx:id="totalLabel" styleClass="subtle"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="snCol" text="SN" minWidth="50" maxWidth="70"/>
                <TableColumn fx:id="nameCol" text="Name"/>
                <TableColumn fx:id="provCol" text="Province"/>
            </columns>
        </TableView>
    </VBox>
</VBox>